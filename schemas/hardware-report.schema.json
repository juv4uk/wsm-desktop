{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/juv4uk/wsm-desktop/blob/main/schemas/hardware-report.schema.json",
  "title": "WSM Hardware Evidence Report",
  "description": "Backend-neutral evidence report. Contains observations and test results, not an overall compatibility score. 1.1.0 adds optional device objects (cpu, gpu, network, storage), boot_mode_evidence and platform.bios_release; a 1.0.0 report remains valid under schemas/hardware-report-1.0.0.schema.json.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "report_id",
    "collected_at",
    "environment",
    "collectors",
    "devices",
    "privacy"
  ],
  "properties": {
    "schema_version": {
      "const": "1.1.0",
      "description": "Report schema version. 1.0.0 documents validate against the frozen 1.0.0 schema; this file is the published 1.1.0 revision."
    },
    "report_id": {
      "type": "string",
      "minLength": 16,
      "maxLength": 80,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "collected_at": {
      "type": "string",
      "format": "date-time"
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "architecture",
        "kernel_release",
        "boot_mode",
        "virtualization"
      ],
      "properties": {
        "architecture": {
          "type": "string",
          "minLength": 1
        },
        "kernel_release": {
          "type": "string",
          "minLength": 1
        },
        "kernel_version": {
          "type": "string"
        },
        "boot_mode": {
          "enum": [
            "uefi",
            "bios",
            "unknown"
          ]
        },
        "virtualization": {
          "enum": [
            "none-detected",
            "kvm",
            "qemu",
            "vmware",
            "hyper-v",
            "xen",
            "container",
            "other",
            "unknown"
          ]
        },
        "platform": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "system_vendor": {
              "type": "string"
            },
            "product_name": {
              "type": "string"
            },
            "board_vendor": {
              "type": "string"
            },
            "board_name": {
              "type": "string"
            },
            "board_version": {
              "type": "string"
            },
            "bios_vendor": {
              "type": "string"
            },
            "bios_version": {
              "type": "string"
            },
            "bios_date": {
              "type": "string",
              "format": "date"
            },
            "bios_release": {
              "type": "string",
              "description": "DMI BIOS release string (sysfs:/class/dmi/id/bios_release)."
            }
          }
        },
        "boot_mode_evidence": {
          "type": "string",
          "minLength": 1,
          "description": "Why the boot mode was chosen: which read-only source was present or absent. Evidence, not a verdict about the firmware settings."
        }
      }
    },
    "collectors": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "available",
          "scope"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string"
          },
          "available": {
            "type": "boolean"
          },
          "scope": {
            "enum": [
              "unprivileged-read-only",
              "privileged-read-only",
              "offline-database"
            ]
          },
          "exit_code": {
            "type": "integer"
          },
          "source_url": {
            "type": "string",
            "format": "uri"
          },
          "notes": {
            "type": "string"
          }
        }
      }
    },
    "devices": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/device"
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile",
        "network_upload_performed",
        "sensitive_identifiers_included",
        "network_requests_performed"
      ],
      "properties": {
        "profile": {
          "enum": [
            "strict-local",
            "sanitized-export",
            "custom"
          ]
        },
        "network_upload_performed": {
          "const": false
        },
        "sensitive_identifiers_included": {
          "const": false
        },
        "redactions_applied": {
          "type": "array",
          "items": {
            "enum": [
              "serial-number",
              "mac-address",
              "uuid",
              "hostname",
              "username",
              "ip-address",
              "storage-wwn",
              "other"
            ]
          }
        },
        "network_requests_performed": {
          "const": false
        }
      }
    }
  },
  "$defs": {
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "source",
        "observed_at",
        "confidence",
        "summary"
      ],
      "properties": {
        "kind": {
          "enum": [
            "live-observation",
            "kernel-log",
            "database-record",
            "functional-test",
            "manual-review",
            "user-reported"
          ]
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "source_version": {
          "type": "string"
        },
        "source_url": {
          "type": "string",
          "format": "uri"
        },
        "observed_at": {
          "type": "string",
          "format": "date-time"
        },
        "confidence": {
          "enum": [
            "confirmed",
            "strong",
            "limited",
            "unknown"
          ]
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "reference": {
          "type": "string"
        }
      }
    },
    "device": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "device_id",
        "category",
        "bus",
        "discovery_status",
        "driver",
        "firmware",
        "functional_tests",
        "evidence"
      ],
      "properties": {
        "device_id": {
          "type": "string",
          "minLength": 1,
          "description": "Ephemeral ID local to this report; never a serial number or globally persistent hardware identifier."
        },
        "category": {
          "enum": [
            "cpu",
            "motherboard",
            "memory",
            "storage-controller",
            "storage-device",
            "network",
            "gpu",
            "display",
            "audio",
            "input",
            "bluetooth",
            "usb-controller",
            "camera",
            "other"
          ]
        },
        "bus": {
          "enum": [
            "pci",
            "usb",
            "platform",
            "acpi",
            "cpu",
            "virtio",
            "mmc",
            "nvme",
            "scsi",
            "i2c",
            "spi",
            "drm",
            "edid",
            "other",
            "unknown"
          ]
        },
        "criticality": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "boot-path",
              "storage-install-target",
              "primary-display",
              "network-installation",
              "input",
              "audio",
              "suspend-resume",
              "optional-peripheral"
            ]
          }
        },
        "identity": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "vendor_id": {
              "type": "string",
              "pattern": "^(0x)?[0-9a-fA-F]{4}$"
            },
            "device_id": {
              "type": "string",
              "pattern": "^(0x)?[0-9a-fA-F]{4}$"
            },
            "subsystem_vendor_id": {
              "type": "string",
              "pattern": "^(0x)?[0-9a-fA-F]{4}$"
            },
            "subsystem_device_id": {
              "type": "string",
              "pattern": "^(0x)?[0-9a-fA-F]{4}$"
            },
            "revision": {
              "type": "string"
            },
            "class_id": {
              "type": "string"
            },
            "modalias": {
              "type": "string"
            },
            "manufacturer": {
              "type": "string"
            },
            "model": {
              "type": "string"
            },
            "local_path": {
              "type": "string"
            }
          }
        },
        "discovery_status": {
          "enum": [
            "discovered",
            "not-detected",
            "unknown"
          ]
        },
        "driver": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status"
          ],
          "properties": {
            "status": {
              "enum": [
                "bound",
                "module-loaded-unbound",
                "available-only",
                "none-known",
                "error",
                "not-applicable",
                "unknown"
              ]
            },
            "candidate": {
              "type": "string"
            },
            "module": {
              "type": "string"
            },
            "module_loaded": {
              "type": "boolean"
            },
            "bound_driver": {
              "type": "string"
            },
            "kernel_config_symbol": {
              "type": "string"
            },
            "notes": {
              "type": "string"
            }
          }
        },
        "firmware": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "requirement",
            "runtime_status"
          ],
          "properties": {
            "requirement": {
              "enum": [
                "required",
                "optional",
                "not-required",
                "unknown"
              ]
            },
            "runtime_status": {
              "enum": [
                "loaded",
                "available-not-confirmed-loaded",
                "missing",
                "load-error",
                "not-needed",
                "unknown"
              ]
            },
            "files_observed": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "package_candidates": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "kernel_log_evidence": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "redistribution_status": {
              "enum": [
                "free",
                "nonfree",
                "mixed",
                "unknown",
                "not-applicable"
              ]
            }
          }
        },
        "display": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "connector": {
              "type": "string"
            },
            "connected": {
              "type": "boolean"
            },
            "edid_manufacturer": {
              "type": "string"
            },
            "edid_product_code": {
              "type": "string"
            },
            "advertised_modes": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "active_mode": {
              "type": "string"
            },
            "refresh_rate_hz": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          }
        },
        "functional_tests": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "capability",
              "status"
            ],
            "properties": {
              "capability": {
                "type": "string",
                "minLength": 1
              },
              "status": {
                "enum": [
                  "passed",
                  "failed",
                  "partial",
                  "not-run",
                  "unsupported",
                  "unknown"
                ]
              },
              "tested_at": {
                "type": "string",
                "format": "date-time"
              },
              "method": {
                "type": "string"
              },
              "result": {
                "type": "string"
              },
              "evidence_refs": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          }
        },
        "recommendations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "action",
              "explanation",
              "confidence"
            ],
            "properties": {
              "action": {
                "enum": [
                  "select-kernel",
                  "install-package",
                  "provide-firmware",
                  "use-wired-network",
                  "use-fallback-graphics",
                  "connect-device",
                  "manual-review",
                  "no-action"
                ]
              },
              "target": {
                "type": "string"
              },
              "explanation": {
                "type": "string",
                "minLength": 1
              },
              "confidence": {
                "enum": [
                  "confirmed",
                  "strong",
                  "limited",
                  "unknown"
                ]
              },
              "evidence_refs": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        "cpu": {
          "type": "object",
          "additionalProperties": false,
          "description": "Processor revision facts from procfs/sysfs; CPU flags live in wsm-cpu-isa/1.",
          "properties": {
            "family": {
              "type": "string"
            },
            "model_number": {
              "type": "string"
            },
            "stepping": {
              "type": "string"
            },
            "microcode": {
              "type": "string"
            },
            "logical_processors": {
              "type": "integer",
              "minimum": 1
            },
            "unavailable": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Facts in this object that no readable source provided. A fact listed here is unknown; it is never replaced by a default or an assumption."
            }
          }
        },
        "gpu": {
          "type": "object",
          "additionalProperties": false,
          "description": "GPU-specific sysfs facts for a PCI display function.",
          "properties": {
            "boot_vga": {
              "type": "boolean"
            },
            "drm_cards": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "DRM card nodes owned by this PCI function."
            },
            "pci_link": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "current_speed": {
                  "type": "string"
                },
                "current_width": {
                  "type": "integer",
                  "minimum": 1
                },
                "max_speed": {
                  "type": "string"
                },
                "max_width": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            },
            "unavailable": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Facts in this object that no readable source provided. A fact listed here is unknown; it is never replaced by a default or an assumption."
            }
          }
        },
        "network": {
          "type": "object",
          "additionalProperties": false,
          "description": "Interfaces that sysfs attributes to this PCI network function.",
          "properties": {
            "status": {
              "enum": [
                "observed",
                "unknown"
              ]
            },
            "interfaces": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "name"
                ],
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "operstate": {
                    "type": "string"
                  },
                  "carrier": {
                    "type": "boolean"
                  },
                  "speed_mbps": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "duplex": {
                    "type": "string"
                  },
                  "mtu": {
                    "type": "integer",
                    "minimum": 1
                  }
                }
              }
            },
            "unavailable": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Facts in this object that no readable source provided. A fact listed here is unknown; it is never replaced by a default or an assumption."
            }
          }
        },
        "storage": {
          "type": "object",
          "additionalProperties": false,
          "description": "Storage topology the installer needs: capacity, sector sizes, medium type, transport and the partitions sysfs exposes. Partition tables and filesystem types are not read.",
          "properties": {
            "capacity_bytes": {
              "type": "integer",
              "minimum": 0
            },
            "logical_block_size": {
              "type": "integer",
              "minimum": 1
            },
            "physical_block_size": {
              "type": "integer",
              "minimum": 1
            },
            "rotational": {
              "type": "boolean"
            },
            "removable": {
              "type": "boolean"
            },
            "read_only": {
              "type": "boolean"
            },
            "transport": {
              "enum": [
                "nvme",
                "sata",
                "usb",
                "mmc",
                "virtio",
                "scsi-other",
                "unknown"
              ]
            },
            "partitions": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "name"
                ],
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "number": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "start_sector": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "sectors": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              }
            },
            "unavailable": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Facts in this object that no readable source provided. A fact listed here is unknown; it is never replaced by a default or an assumption."
            }
          }
        }
      }
    }
  }
}
