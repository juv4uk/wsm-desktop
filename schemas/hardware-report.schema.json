{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/juv4uk/wsm-desktop/blob/main/schemas/hardware-report.schema.json",
  "title": "WSM Hardware Evidence Report",
  "description": "Backend-neutral evidence report. Contains observations and test results, not an overall compatibility score.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "report_id",
    "collected_at",
    "environment",
    "collectors",
    "devices",
    "privacy"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "report_id": {
      "type": "string",
      "minLength": 16,
      "maxLength": 80,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "collected_at": {
      "type": "string",
      "format": "date-time"
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "architecture",
        "kernel_release",
        "boot_mode",
        "virtualization"
      ],
      "properties": {
        "architecture": {
          "type": "string",
          "minLength": 1
        },
        "kernel_release": {
          "type": "string",
          "minLength": 1
        },
        "kernel_version": {
          "type": "string"
        },
        "boot_mode": {
          "enum": [
            "uefi",
            "bios",
            "unknown"
          ]
        },
        "virtualization": {
          "enum": [
            "none-detected",
            "kvm",
            "qemu",
            "vmware",
            "hyper-v",
            "xen",
            "container",
            "other",
            "unknown"
          ]
        },
        "platform": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "system_vendor": {
              "type": "string"
            },
            "product_name": {
              "type": "string"
            },
            "board_vendor": {
              "type": "string"
            },
            "board_name": {
              "type": "string"
            },
            "board_version": {
              "type": "string"
            },
            "bios_vendor": {
              "type": "string"
            },
            "bios_version": {
              "type": "string"
            },
            "bios_date": {
              "type": "string",
              "format": "date"
            }
          }
        }
      }
    },
    "collectors": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "available",
          "scope"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string"
          },
          "available": {
            "type": "boolean"
          },
          "scope": {
            "enum": [
              "unprivileged-read-only",
              "privileged-read-only",
              "offline-database"
            ]
          },
          "exit_code": {
            "type": "integer"
          },
          "source_url": {
            "type": "string",
            "format": "uri"
          },
          "notes": {
            "type": "string"
          }
        }
      }
    },
    "devices": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/device"
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile",
        "network_upload_performed",
        "sensitive_identifiers_included",
        "network_requests_performed"
      ],
      "properties": {
        "profile": {
          "enum": [
            "strict-local",
            "sanitized-export",
            "custom"
          ]
        },
        "network_upload_performed": {
          "const": false
        },
        "sensitive_identifiers_included": {
          "const": false
        },
        "redactions_applied": {
          "type": "array",
          "items": {
            "enum": [
              "serial-number",
              "mac-address",
              "uuid",
              "hostname",
              "username",
              "ip-address",
              "storage-wwn",
              "other"
            ]
          }
        },
        "network_requests_performed": {
          "const": false
        }
      }
    }
  },
  "$defs": {
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "source",
        "observed_at",
        "confidence",
        "summary"
      ],
      "properties": {
        "kind": {
          "enum": [
            "live-observation",
            "kernel-log",
            "database-record",
            "functional-test",
            "manual-review",
            "user-reported"
          ]
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "source_version": {
          "type": "string"
        },
        "source_url": {
          "type": "string",
          "format": "uri"
        },
        "observed_at": {
          "type": "string",
          "format": "date-time"
        },
        "confidence": {
          "enum": [
            "confirmed",
            "strong",
            "limited",
            "unknown"
          ]
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "reference": {
          "type": "string"
        }
      }
    },
    "device": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "device_id",
        "category",
        "bus",
        "discovery_status",
        "driver",
        "firmware",
        "functional_tests",
        "evidence"
      ],
      "properties": {
        "device_id": {
          "type": "string",
          "minLength": 1,
          "description": "Ephemeral ID local to this report; never a serial number or globally persistent hardware identifier."
        },
        "category": {
          "enum": [
            "cpu",
            "motherboard",
            "memory",
            "storage-controller",
            "storage-device",
            "network",
            "gpu",
            "display",
            "audio",
            "input",
            "bluetooth",
            "usb-controller",
            "camera",
            "other"
          ]
        },
        "bus": {
          "enum": [
            "pci",
            "usb",
            "platform",
            "acpi",
            "cpu",
            "virtio",
            "mmc",
            "nvme",
            "scsi",
            "i2c",
            "spi",
            "drm",
            "edid",
            "other",
            "unknown"
          ]
        },
        "criticality": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "boot-path",
              "storage-install-target",
              "primary-display",
              "network-installation",
              "input",
              "audio",
              "suspend-resume",
              "optional-peripheral"
            ]
          }
        },
        "identity": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "vendor_id": {
              "type": "string",
              "pattern": "^(0x)?[0-9a-fA-F]{4}$"
            },
            "device_id": {
              "type": "string",
              "pattern": "^(0x)?[0-9a-fA-F]{4}$"
            },
            "subsystem_vendor_id": {
              "type": "string",
              "pattern": "^(0x)?[0-9a-fA-F]{4}$"
            },
            "subsystem_device_id": {
              "type": "string",
              "pattern": "^(0x)?[0-9a-fA-F]{4}$"
            },
            "revision": {
              "type": "string"
            },
            "class_id": {
              "type": "string"
            },
            "modalias": {
              "type": "string"
            },
            "manufacturer": {
              "type": "string"
            },
            "model": {
              "type": "string"
            },
            "local_path": {
              "type": "string"
            }
          }
        },
        "discovery_status": {
          "enum": [
            "discovered",
            "not-detected",
            "unknown"
          ]
        },
        "driver": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status"
          ],
          "properties": {
            "status": {
              "enum": [
                "bound",
                "module-loaded-unbound",
                "available-only",
                "none-known",
                "error",
                "not-applicable",
                "unknown"
              ]
            },
            "candidate": {
              "type": "string"
            },
            "module": {
              "type": "string"
            },
            "module_loaded": {
              "type": "boolean"
            },
            "bound_driver": {
              "type": "string"
            },
            "kernel_config_symbol": {
              "type": "string"
            },
            "notes": {
              "type": "string"
            }
          }
        },
        "firmware": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "requirement",
            "runtime_status"
          ],
          "properties": {
            "requirement": {
              "enum": [
                "required",
                "optional",
                "not-required",
                "unknown"
              ]
            },
            "runtime_status": {
              "enum": [
                "loaded",
                "available-not-confirmed-loaded",
                "missing",
                "load-error",
                "not-needed",
                "unknown"
              ]
            },
            "files_observed": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "package_candidates": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "kernel_log_evidence": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "redistribution_status": {
              "enum": [
                "free",
                "nonfree",
                "mixed",
                "unknown",
                "not-applicable"
              ]
            }
          }
        },
        "display": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "connector": {
              "type": "string"
            },
            "connected": {
              "type": "boolean"
            },
            "edid_manufacturer": {
              "type": "string"
            },
            "edid_product_code": {
              "type": "string"
            },
            "advertised_modes": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "active_mode": {
              "type": "string"
            },
            "refresh_rate_hz": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          }
        },
        "functional_tests": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "capability",
              "status"
            ],
            "properties": {
              "capability": {
                "type": "string",
                "minLength": 1
              },
              "status": {
                "enum": [
                  "passed",
                  "failed",
                  "partial",
                  "not-run",
                  "unsupported",
                  "unknown"
                ]
              },
              "tested_at": {
                "type": "string",
                "format": "date-time"
              },
              "method": {
                "type": "string"
              },
              "result": {
                "type": "string"
              },
              "evidence_refs": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          }
        },
        "recommendations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "action",
              "explanation",
              "confidence"
            ],
            "properties": {
              "action": {
                "enum": [
                  "select-kernel",
                  "install-package",
                  "provide-firmware",
                  "use-wired-network",
                  "use-fallback-graphics",
                  "connect-device",
                  "manual-review",
                  "no-action"
                ]
              },
              "target": {
                "type": "string"
              },
              "explanation": {
                "type": "string",
                "minLength": 1
              },
              "confidence": {
                "enum": [
                  "confirmed",
                  "strong",
                  "limited",
                  "unknown"
                ]
              },
              "evidence_refs": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  }
}
