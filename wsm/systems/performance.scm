;;
;; WSM Desktop — служби, які впливають на чуйність системи.
;;
;; СТАТУС: не зібрано й не перевірено (у середовищі написання немає Guix).
;;
;; Що це і чого це не є:
;;
;; Це не «прискорювач». Це три служби, кожна з яких зменшує конкретну затримку,
;; яку користувач відчуває щодня, і кожна з яких вимірювана окремо.
;;
;; Чому не -O3 і не -march=native для всієї системи: глобальні прапорці роблять
;; збірку невідтворюваною й ламають систему на іншому залізі. Guix має чесніший
;; механізм — `--tune`, який оптимізує лише позначені пакети, графтить їх у
;; граф залежностей і записує перетворення так, що збірку можна повторити.
;; Деталі й межі — у docs/PERFORMANCE.md.

(define-module (wsm systems performance)
  #:use-module (gnu services)
  #:use-module (gnu services linux)
  #:export (%wsm-performance-services))

(define %wsm-performance-services
  (list
   ;; Стиснений swap у пам'яті. На машині з 8-16 ГБ це головна причина, чому
   ;; система «замислюється» при відкритті важкої програми: без нього ядро
   ;; починає витісняти сторінки на диск, і затримка стає в десятки разів
   ;; більшою. zstd обрано за кращий коефіцієнт при прийнятній швидкості;
   ;; lz4 швидший, але стискає гірше.
   ;;
   ;; priority не задаємо: у Guix значення -1 оголошено застарілим.
   (service zram-device-service-type
            (zram-device-configuration
             (size "4G")
             (compression-algorithm 'zstd)))

   ;; Ранній OOM. Штатний killer прокидається, коли пам'яті вже немає, і доти
   ;; система хвилинами не реагує на мишу. earlyoom вбиває найбільшого
   ;; споживача заздалегідь — це не «швидше», це «не зависає».
   (service earlyoom-service-type
            (earlyoom-configuration
             (minimum-available-memory 10)
             (minimum-free-swap 10)))

   ;; TRIM для SSD. Не прискорює сам по собі, але без нього запис деградує з
   ;; часом; типове розкладено раз на тиждень.
   (service fstrim-service-type)))
